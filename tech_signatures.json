                "tailwind.css"
            ]
        },
        {
            "name": "Wix",
            "html_patterns": [
                "wix.com",
                "static.wixstatic.com",
                "wix-code-sdk"
            ]
        },
        {
            "name": "Squarespace",
            "html_patterns": [
                "static1.squarespace.com",
                "squarespace-config"
            ]
        },
        {
            "name": "jQuery",
            "html_patterns": [
                "jquery.min.js",
                "jquery.js",
                "jquery-migrate"
            ]
        },
        {
            "name": "Bootstrap",
            "html_patterns": [
                "bootstrap.min.css",
                "bootstrap.min.js",
                "bootstrap.bundle"
            ]
        },
        {
            "name": "Google Fonts",
            "html_patterns": [
                "fonts.googleapis.com",
                "fonts.gstatic.com"
            ]
        },
        {
            "name": "Font Awesome",
            "html_patterns": [
                "fontawesome.com",
                "font-awesome",
                "fa-solid",
                "fa-brands"
            ]
        },
        {
            "name": "Elementor",
            "html_patterns": [
                "elementor-container",
                "elementor-widget",
                "elementor-main"
            ]
        },
        {
            "name": "WooCommerce",
            "html_patterns": [
                "woocommerce-no-js",
                "wc-cart-fragments",
                "woocommerce-layout"
            ]
        },
        {
            "name": "Facebook Pixel",
            "html_patterns": [
