{
    "technologies": [
        {
            "name": "Shopify",
            "html_patterns": [
                "cdn.shopify.com",
                "shopify.com",
                "shopify-payment-button"
            ],
            "meta_tags": {
                "generator": "Shopify"
            }
        },
        {
            "name": "WordPress",
            "html_patterns": [
                "wp-content",
                "wp-includes"
            ],
            "meta_tags": {
                "generator": "WordPress"
            }
        },
        {
            "name": "Google Analytics",
            "html_patterns": [
                "google-analytics.com/analytics.js",
                "google-analytics.com/ga.js",
                "googletagmanager.com/gtm.js"
            ],
            "scripts": [
                "ga.js",
                "gtm.js"
            ]
        },
        {
            "name": "Cloudflare",
            "html_patterns": [
                "cloudflare.com",
                "cloudflare-static.com"
            ],
            "headers": [
                "server: cloudflare"
            ]
        },
        {
            "name": "React",
            "html_patterns": [
                "react.production.min.js",
                "_reactRootContainer",
                "react-dom"
            ]
        },
        {
            "name": "Tailwind CSS",
            "html_patterns": [
